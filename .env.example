# ═══════════════════════════════════════════════════════════════════════════
#  PUT YOUR KEYS IN  .env.local      (this file is the template)
#  .env.local is gitignored. On Vercel, the same names go in
#  Project → Settings → Environment Variables. Never commit a real key.
# ═══════════════════════════════════════════════════════════════════════════

# ── SIGN-IN ────────────────────────────────────────────────────────────────
# Accounts, as username:password pairs separated by commas.
# This is a classroom gate, not real authentication — see README.
# Do NOT commit working credentials — this file is public. Set real ones in .env.local.
APP_USERS=learner:CHANGE_ME,teacher:CHANGE_ME_TOO

# Signs the session cookie so it cannot be forged. Change it to anything long.
AUTH_SECRET=CHANGE_ME_to_a_long_random_string

# ── MODEL SLOTS ────────────────────────────────────────────────────────────
# Three independent slots, each with its own key, provider and model.
# Free tiers are rate limited PER KEY and the phases of a turn fire back to
# back, so separate keys stop one 429 from taking down a whole round.
#
# Model ids are sent to the provider verbatim and never validated in code, so
# any id your account can serve works. An id the provider does not recognise
# returns 404 and the next slot takes over automatically.

# Slot 1 — Google AI Studio   https://aistudio.google.com/apikey
SLOT1_PROVIDER=google
SLOT1_API_KEY=
SLOT1_MODEL=gemma-4-31b-it

# Slot 2 — Google AI Studio (second key, second model)
SLOT2_PROVIDER=google
SLOT2_API_KEY=
SLOT2_MODEL=gemma-4-26b-a4b-it

# Slot 3 — OpenRouter          https://openrouter.ai/keys
SLOT3_PROVIDER=openrouter
SLOT3_API_KEY=
SLOT3_MODEL=google/gemma-4-31b-it:free

# Which slot each job reaches for first; the others become its failover chain.
PREDICT_SLOT=1       # Mira + Aarav
ADJUDICATE_SLOT=2    # Dr. Sen
BUILD_SLOT=1         # building the food web from the animal she names
CHAT_SLOT=3          # the "Ask Mira" doubt chat

# Per-call timeout. Keep it low: a slow connection (C1) should fall back fast
# rather than leave the learner staring at a spinner.
LLM_TIMEOUT_MS=20000

# Identity token shown in the footer of every screen and on the About screen.
NEXT_PUBLIC_ROLL_NO=24B0073
