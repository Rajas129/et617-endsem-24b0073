# ═══════════════════════════════════════════════════════════════════════════
#  PUT YOUR KEYS IN  .env.local      (this file is the template)
#  .env.local is gitignored. On Vercel, the same names go in
#  Project → Settings → Environment Variables. Never commit a real key.
# ═══════════════════════════════════════════════════════════════════════════

# ── SIGN-IN ────────────────────────────────────────────────────────────────
# Accounts, as username:password pairs separated by commas.
# This is a classroom gate, not real authentication — see README.
# Do NOT commit working credentials — this file is public. Set real ones in .env.local.
APP_USERS=learner:CHANGE_ME,teacher:CHANGE_ME_TOO

# Signs the session cookie so it cannot be forged. Change it to anything long.
AUTH_SECRET=CHANGE_ME_to_a_long_random_string

# ── MODEL SLOTS ────────────────────────────────────────────────────────────
# All three slots run through OpenRouter on the same key for now. The Google AI
# Studio Gemma 4 endpoints were hanging until timeout rather than failing fast,
# which burned the whole request budget before a healthy slot was reached.
#
# Slot 1 is the :free auto-router, which picks whatever has capacity at the time.
# Slots 2 and 3 name specific Gemma 4 models as backups.

SLOT1_PROVIDER=openrouter
SLOT1_API_KEY=
SLOT1_MODEL=openrouter/free

SLOT2_PROVIDER=openrouter
SLOT2_API_KEY=
SLOT2_MODEL=google/gemma-4-31b-it:free

SLOT3_PROVIDER=openrouter
SLOT3_API_KEY=
SLOT3_MODEL=google/gemma-4-26b-a4b-it:free

# Everything prefers the auto-router; the named models are its failover.
PREDICT_SLOT=1
ADJUDICATE_SLOT=1
BUILD_SLOT=1
CHAT_SLOT=1

# To put Google AI Studio back in, set a slot to:
#   SLOTn_PROVIDER=google
#   SLOTn_API_KEY=<key from https://aistudio.google.com/apikey>
#   SLOTn_MODEL=gemma-4-31b-it      (bare id, not namespaced)

# Per-call timeout, and the total wall-clock budget for one request across the
# whole slot chain. The budget must stay under the serverless function limit
# (60s) or the function is killed mid-chain and the learner gets nothing.
LLM_TIMEOUT_MS=26000
LLM_BUDGET_MS=50000

# How long to wait for one slot before ALSO starting the next one. Slots run
# concurrently after this and the first valid reply wins, so a slot that hangs
# costs a few seconds of overlap instead of the whole request.
#
# Set HIGH (effectively sequential) while every slot shares one OpenRouter key:
# hedging would fire up to 3 requests per turn against the SAME upstream limit,
# burning a 50/day free allowance three times faster for no gain. Lower it to
# ~6000 only when the slots use genuinely different keys or providers.
LLM_HEDGE_MS=20000

# Token multiplier for OpenRouter. The :free auto-router can land on a reasoning
# model, which spends tokens thinking before it answers and needs the headroom.
OPENROUTER_HEADROOM=3

# Identity token shown in the footer of every screen and on the About screen.
NEXT_PUBLIC_ROLL_NO=24B0073
